ACTIVATION_TTL_SECONDS=1800
CANONICAL_HOST=rag.home.arpa
CANONICAL_ORIGIN=https://rag.home.arpa
COORDINATOR_BASE_URL=http://127.0.0.1:8100
COORDINATOR_SERVICE_TOKEN=REPLACE_WITH_32_CHARACTER_SECRET
CONTROLLER_BASE_URL=http://127.0.0.1:8102
CONTROLLER_SERVICE_TOKEN=REPLACE_WITH_DISTINCT_32_CHARACTER_SECRET
CORS_ORIGINS=[]
CSRF_SIGNING_SECRET=REPLACE_WITH_32_CHARACTER_SECRET
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_URL=postgresql+psycopg://rag_api:REPLACE@127.0.0.1:5432/rag
DEPLOYMENT_ID=rag-v4-local
ENVIRONMENT=production
ENABLE_V6_ADAPTIVE_PARSING=true
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_API_KEY_ID
OBJECT_STORAGE_BUCKET=rag-originals
OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_READ_TIMEOUT_SECONDS=60
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_API_SECRET
OBJECT_STORAGE_USE_TLS=false
OCR_PYTHON_EXECUTABLE=C:\Program Files\LocalRAG\current\runtimes\ocr-python\python.exe
PASSWORD_HASH_CONCURRENCY=2
PREAUTH_CSRF_TTL_SECONDS=900
PYTHONNOUSERSITE=1
PYTHONUTF8=1
RAG_API_CLIENT_CA_PATH=C:\ProgramData\LocalRAG\certificates\local-rag-ca.crt
RAG_API_TLS_CERT_PATH=C:\ProgramData\LocalRAG\certificates\api-loopback.crt
