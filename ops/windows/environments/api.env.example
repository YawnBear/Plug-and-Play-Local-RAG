RAG_SUPERVISOR_API_CLIENT_CERT_PATH=C:\ProgramData\LocalRAG\certificates\supervisor-api-client.crt
RAG_SUPERVISOR_API_CLIENT_KEY_PATH=C:\ProgramData\LocalRAG\secrets\supervisor-api-client.key
SESSION_IDLE_SECONDS=1800
TEMP=C:\ProgramData\LocalRAG\profiles\api\tmp
TMP=C:\ProgramData\LocalRAG\profiles\api\tmp
USERPROFILE=C:\ProgramData\LocalRAG\profiles\api
