{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-rag.invalid/schemas/v8a/capability-profiles.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_revision", "profiles"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "catalog_id": {"type": "string", "const": "local-rag-v8a-baseline"},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "profiles": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "function",
          "release_support_class",
          "operating_system",
          "architecture",
          "accelerator_vendor",
          "engine",
          "model_identity",
          "artifact_ids",
          "minimum_ram_gib",
          "minimum_vram_gib",
          "local_validation_fixture",
          "impact_class"
        ],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
          "function": {"type": "string", "enum": ["generation", "embedding", "reranking", "ocr"]},
          "release_support_class": {"type": "string", "enum": ["release_qualified", "experimental", "unavailable"]},
          "operating_system": {"type": "string", "enum": ["windows", "linux", "macos"]},
          "architecture": {"type": "string", "enum": ["x64", "arm64"]},
          "accelerator_vendor": {"type": "string", "enum": ["cpu", "nvidia", "amd", "intel", "apple", "other"]},
          "runtime_device": {"type": "string", "pattern": "^(cpu|gpu:[0-9]+)$"},
          "engine": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
          "model_identity": {"type": "string", "minLength": 1, "maxLength": 128},
          "artifact_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"}
          },
          "minimum_ram_gib": {"type": "integer", "minimum": 1, "maximum": 1024},
          "minimum_vram_gib": {"type": "integer", "minimum": 0, "maximum": 256},
          "local_validation_fixture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
          "impact_class": {"type": "string", "enum": ["restart_generation", "full_shadow_reindex", "restart_reranker", "restart_ocr"]}
        }
      }
    }
  }
}
