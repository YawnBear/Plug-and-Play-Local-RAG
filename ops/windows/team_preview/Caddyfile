{
	admin off
	auto_https off
	servers {
		protocols h1 h2
		timeouts {
			read_body 10m
			read_header 30s
			idle 0
		}
	}
}

https://rag.home.arpa:443 {
	bind {$RAG_LAN_IPV4}
	tls C:\ProgramData\LocalRAG\certificates\rag.home.arpa.crt C:\ProgramData\LocalRAG\secrets\rag.home.arpa.key
	request_body {
		max_size 100MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	@document_content path_regexp ^/api/documents/[0-9a-fA-F-]{36}/content$
	@non_document_content not path_regexp ^/api/documents/[0-9a-fA-F-]{36}/content$
	header @document_content X-Frame-Options "SAMEORIGIN"
	header @non_document_content X-Frame-Options "DENY"
	import C:\Program Files\LocalRAG\current\csp-header.caddy
	@api path /api/*
	handle @api {
		reverse_proxy https://127.0.0.1:8443 {
			flush_interval -1
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up Host rag.home.arpa
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host rag.home.arpa
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				tls_server_name rag-api-loopback
				tls_trusted_ca_certs C:\ProgramData\LocalRAG\certificates\loopback-ca.crt
				tls_client_auth C:\ProgramData\LocalRAG\certificates\caddy-api-client.crt C:\ProgramData\LocalRAG\secrets\caddy-api-client.key
			}
		}
	}
	handle {
		reverse_proxy http://127.0.0.1:3000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up Host rag.home.arpa
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host rag.home.arpa
			header_up X-Forwarded-Proto https
		}
	}
}
