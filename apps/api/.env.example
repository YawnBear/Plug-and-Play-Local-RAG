ENVIRONMENT=development
SESSION_IDLE_SECONDS=1800
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL=postgresql+psycopg://rag_api:replace-with-api-password@127.0.0.1:5432/rag
WORKER_DATABASE_URL=postgresql+psycopg://rag_worker:replace-with-worker-password@127.0.0.1:5432/rag
MAINTENANCE_DATABASE_URL=postgresql+psycopg://rag_maintenance:replace-with-maintenance-password@127.0.0.1:5432/rag
MIGRATION_DATABASE_URL=postgresql+psycopg://rag_migrator:replace-with-migrator-password@127.0.0.1:5432/rag
DATA_ROOT=C:\local-rag\data
OCR_PYTHON_EXECUTABLE=C:\path\to\.venv-ocr\Scripts\python.exe
OCR_TIMEOUT_SECONDS=900
OCR_PIPELINE_VERSION=v1.6
OCR_DEVICE=cpu
OCR_CPU_THREADS=10
OCR_PAGE_BATCH_SIZE=8
# Optional in contributor mode. Personal production generates this secret and
# uses it only for the API's fixed V8C OCR validation operation.
OCR_SERVICE_BASE_URL=http://127.0.0.1:8101
OCR_SERVICE_TOKEN=
# Optional in contributor mode. Production uses a distinct secret and the
# fixed loopback controller origin; no command, path, URL, or env name crosses it.
CONTROLLER_BASE_URL=http://127.0.0.1:8102
CONTROLLER_SERVICE_TOKEN=
EMBEDDING_BATCH_SIZE=16
EXTERNAL_BATCH_MAX_ATTEMPTS=2
ENABLE_V6_ADAPTIVE_PARSING=true
# Provisional V6 Core work limits. Calibrate on the target host before production.
MAXIMUM_PDF_PAGES=500
MAXIMUM_OCR_PAGES=128
MAXIMUM_DOCUMENT_CHUNKS=5000
MAXIMUM_EXTRACTED_TEXT_CHARACTERS=10000000
MAXIMUM_STAGED_OCR_RESULT_BYTES=67108864
INGESTION_PROCESSING_TIMEOUT_SECONDS=3600
OLLAMA_BASE_URL=http://127.0.0.1:11434
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GENERATION_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
MAXIMUM_GENERATION_CONTEXT=16384
MAXIMUM_GENERATION_OUTPUT=3072
GENERATION_TIMEOUT_SECONDS=300
OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=rag-originals
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_USE_TLS=false
OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
OBJECT_STORAGE_READ_TIMEOUT_SECONDS=60
OBJECT_STORAGE_MAX_ATTEMPTS=3
OBJECT_STORAGE_CONNECTION_POOL_SIZE=10
OBJECT_STORAGE_BLOCKING_CONCURRENCY=8
OBJECT_STORAGE_OPERATION_MAX_ATTEMPTS=3
OBJECT_STORAGE_RETRY_BASE_SECONDS=1
OBJECT_DELETION_LEASE_SECONDS=60
OBJECT_DELETION_POLL_SECONDS=2
OBJECT_DELETION_ERROR_LIMIT=500

# Process-isolated deployment uses separate environment files. The API receives
# only DATABASE_URL and the API RustFS key; ingestion/deletion workers receive
# only WORKER_DATABASE_URL and their distinct scoped RustFS keys; maintenance receives only
# MAINTENANCE_DATABASE_URL and the maintenance RustFS key. Alembic alone receives
# MIGRATION_DATABASE_URL. RustFS root credentials and backup credentials never
# belong in an application environment file.
