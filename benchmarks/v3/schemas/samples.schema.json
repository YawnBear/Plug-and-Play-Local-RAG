{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "samples.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sample_id", "stage", "temperature", "queue", "elapsed_ms", "success", "repetition"],
    "properties": {
      "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "stage": {"enum": ["ingest", "ocr", "embedding", "retrieval", "rerank", "generation", "api"]},
      "temperature": {"enum": ["cold", "warm"]},
      "queue": {"enum": ["queue-free", "contended"]},
      "elapsed_ms": {"type": "number", "minimum": 0},
      "first_token_ms": {"type": "number", "minimum": 0},
      "client_first_token_ms": {"type": "number", "minimum": 0},
      "client_final_ms": {"type": "number", "minimum": 0},
      "success": {"type": "boolean"},
      "timeout": {"type": "boolean"},
      "throughput_items_per_s": {"type": "number", "minimum": 0},
      "cpu_percent": {"type": "number", "minimum": 0, "maximum": 100},
      "ram_mb": {"type": "number", "minimum": 0},
      "vram_mb": {"type": "number", "minimum": 0},
      "ram_headroom_mb": {"type": "number", "minimum": 0},
      "vram_headroom_mb": {"type": "number", "minimum": 0},
      "queue_depth": {"type": "integer", "minimum": 0},
      "concurrency": {"type": "integer", "minimum": 1},
      "model_residency": {"enum": ["cold", "warm", "mixed", "unknown"]},
      "corpus_documents": {"type": "integer", "minimum": 0},
      "corpus_chunks": {"type": "integer", "minimum": 0},
      "retrieval_hit_at_20": {"type": "number", "minimum": 0, "maximum": 1},
      "rerank_hit_at_6": {"type": "number", "minimum": 0, "maximum": 1},
      "citation_correct": {"type": "boolean"},
      "abstention_correct": {"type": "boolean"},
      "expected_terms_correct": {"type": "boolean"},
      "case_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "document_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "document_kind": {"enum": ["digital", "scanned"]},
      "fixture_document_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "profile_evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "execution_evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "sample_evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
      "terminal_status": {"const": "completed"},
      "parse_ms": {"type": "number", "minimum": 0},
      "ocr_ms": {"type": "number", "minimum": 0},
      "embedding_ms": {"type": "number", "minimum": 0},
      "retrieval_ms": {"type": "number", "minimum": 0},
      "rerank_ms": {"type": "number", "minimum": 0},
      "generation_ms": {"type": "number", "minimum": 0},
      "repetition": {"type": "integer", "minimum": 1, "maximum": 99}
    }
  }
}
